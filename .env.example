# Every variable listed in docs/03_SECURITY_AND_ACCESS.md section 3.
# Copy to .env and fill. .env is gitignored and must never be committed.

# Razorpay test-mode key pair. Startup refuses any key id that does not start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_key_secret

# Webhook secret configured on the Razorpay dashboard for the webhook endpoint.
# Used for HMAC-SHA256 verification of the raw request body.
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Google AI Studio key. Optional when using the Ollama or fixture LLM providers.
GEMINI_API_KEY=

# Bearer token required by every mutating dashboard and API route.
SALVAGE_DASHBOARD_TOKEN=replace_with_a_long_random_string

# dev or demo. The unsigned webhook replay path exists only when this is dev.
SALVAGE_ENV=dev

# 1 stops all outbound actions. Detection and diagnosis continue.
SALVAGE_KILL_SWITCH=0

# LLM provider selection: gemini, ollama or fixture. CI sets fixture.
# The providers themselves land in M2; M1 only reads and validates this value.
SALVAGE_LLM_PROVIDER=fixture
SALVAGE_LLM_MODEL=gemini-2.5-flash

# SQLite database path. Directory is gitignored.
SALVAGE_DB_PATH=data/salvage.db

# Salt for the customer ref_hash. Change it and existing hashes stop matching.
SALVAGE_REF_HASH_SALT=replace_with_a_long_random_string
